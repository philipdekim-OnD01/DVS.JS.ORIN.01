# SPDX-License-Identifier: GPL-2.0-only
#
# NRV DVS sensor driver (nrv_dvs.ko), out-of-tree kernel module.
#
# This file declares every build dependency of the driver; callers (build.sh,
# a developer shell, an IDE task) only run `make` here.
#
#   make            build $(BUILD_DIR)/nrv_dvs.ko   (default: drivers/dvs/build)
#                   and write build/compile_commands.json for clangd (also
#                   when the build fails)
#   make compdb     only regenerate compile_commands.json
#   make check      only verify the dependencies below
#   make clean      remove the build outputs and the link tree in $(BUILD_DIR)
#
# Kbuild on this kernel (6.8, no MO=) writes objects next to the sources of M=,
# so $(BUILD_DIR) is a tree of per-file symlinks to src/, include/ and the
# headers here, with this file linked as its Kbuild. Edits in src/ are picked up
# directly; added/removed files are re-linked on every `make`.
#
# Dependencies (override on the command line, e.g. `make KDIR=...`):
#   KDIR       kernel build tree of the target kernel (headers + Module.symvers)
#   NV_PUBLIC  NVIDIA OOT public headers + Module.symvers
#              (package nvidia-l4t-kernel-oot-headers, /usr/src/nvidia/nvidia-public)
#   NV_COMPAT  NVIDIA conftest headers (<nvidia/conftest.h>) for this kernel,
#              generated by `../../build.sh drivers` into build/compat
#
# The BSP pin check (kernel/NVIDIA Module.symvers hashes, L4T version) stays in
# build.sh preflight; this Makefile checks that the inputs exist.

ifneq ($(KERNELRELEASE),)
# ---------------------------------------------------------------- Kbuild part
# Evaluated by the kernel build system (make -C $(KDIR) M=$(BUILD_DIR)).

obj-m := nrv_dvs.o

# Every *.c under src/ (recursive) is linked into nrv_dvs.ko. Files meant to be
# #included rather than compiled must not use the .c suffix.
# (-L: in the build dir the sources are symlinks)
DVS_SRCS := $(shell cd $(src) && find -L src -type f -name '*.c' | LC_ALL=C sort)
ifeq ($(DVS_SRCS),)
$(error nrv_dvs: no .c files under $(src)/src)
endif
nrv_dvs-y := $(DVS_SRCS:.c=.o)

# include/ and every directory below it are on the include path, so both
# <dvs/dvs.h> and "dvs.h" resolve. Prefer the <dir/name.h> form: header names
# must stay unique across these directories or the first -I match wins.
DVS_INC_DIRS := $(shell find -L $(src)/include -type d | LC_ALL=C sort)
ccflags-y += $(addprefix -I,$(DVS_INC_DIRS))
ccflags-y += -I$(NV_COMPAT) -I$(NV_PUBLIC)/include

else
# ----------------------------------------------------------------- user part

KERNEL_RELEASE ?= $(shell uname -r)
KDIR      ?= /lib/modules/$(KERNEL_RELEASE)/build
NV_PUBLIC ?= /usr/src/nvidia/nvidia-public
REPO_ROOT := $(abspath $(CURDIR)/../..)
NV_COMPAT ?= $(REPO_ROOT)/build/compat
BUILD_DIR ?= $(CURDIR)/build
override BUILD_DIR := $(abspath $(BUILD_DIR))
# clangd reads this through drivers/dvs/.clangd (CompilationDatabase: build).
COMPDB_OUT ?= $(CURDIR)/build/compile_commands.json

KBUILD_ARGS := -C $(KDIR) M=$(BUILD_DIR) \
	NV_PUBLIC=$(NV_PUBLIC) NV_COMPAT=$(NV_COMPAT) \
	KBUILD_EXTRA_SYMBOLS=$(NV_PUBLIC)/Module.symvers

.PHONY: all modules check clean linktree compdb

all modules: check linktree
	@$(MAKE) $(KBUILD_ARGS) modules; rc=$$?; \
	  $(MAKE) --no-print-directory compdb; exit $$rc

compdb:
	@python3 $(CURDIR)/scripts/compdb.py $(KDIR) $(BUILD_DIR) $(CURDIR) \
	  $(COMPDB_OUT)

# Mirror src/, include/ and top-level headers into $(BUILD_DIR) as symlinks.
linktree:
	@mkdir -p $(BUILD_DIR)
	@for d in src include; do \
	  if [ -d $(BUILD_DIR)/$$d ]; then \
	    find $(BUILD_DIR)/$$d -xtype l -delete; \
	    find $(BUILD_DIR)/$$d -mindepth 1 -depth -type d -empty -delete; \
	  fi; \
	  cp -rsf $(CURDIR)/$$d $(BUILD_DIR)/; \
	done
	@find $(BUILD_DIR) -maxdepth 1 -name '*.h' -type l -delete
	@for h in $(CURDIR)/*.h; do [ -e "$$h" ] && ln -sf "$$h" $(BUILD_DIR)/; done; true
	@ln -sfn $(CURDIR)/Makefile $(BUILD_DIR)/Kbuild

check:
	@test -f $(KDIR)/Module.symvers || { \
	  echo "nrv_dvs: kernel build tree missing: $(KDIR)" >&2; exit 1; }
	@test -f $(NV_PUBLIC)/Module.symvers -a -d $(NV_PUBLIC)/include || { \
	  echo "nrv_dvs: NVIDIA public headers missing: $(NV_PUBLIC)" >&2; exit 1; }
	@test -f $(NV_COMPAT)/nvidia/conftest/headers.h || { \
	  echo "nrv_dvs: conftest headers missing: $(NV_COMPAT)" >&2; \
	  echo "nrv_dvs: run ../../build.sh drivers once (or pass NV_COMPAT=...)" >&2; exit 1; }

# Keeps unrelated files in $(BUILD_DIR) (clangd .cache/); compile_commands.json
# is removed by Kbuild's own clean.
clean:
	@if [ -f $(BUILD_DIR)/Kbuild ]; then $(MAKE) -C $(KDIR) M=$(BUILD_DIR) clean; fi
	@for d in src include; do \
	  [ -d $(BUILD_DIR)/$$d ] && find $(BUILD_DIR)/$$d -type l -delete && \
	    find $(BUILD_DIR)/$$d -depth -type d -empty -delete; \
	done; true
	@find $(BUILD_DIR) -maxdepth 1 \( -name '*.h' -o -name Kbuild \) -type l -delete 2>/dev/null; true

endif
