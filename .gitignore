# NVIDIA sources are fetched + hash-verified, never committed.
/.cache/
# All build outputs (patched NVIDIA tree, modules, dtbo, app binary, test scratch).
/build/
# Relative symlink created by "build.sh app" (-> ../build/dvs_live).
/app/dvs_live
# Runtime state of the receiver app.
/app/*.pid
/app/*.log
/app/dump/
/recordings/
__pycache__/
*.pyc
*.o
*.ko
*.mod
*.mod.c
*.cmd
*.dtb
*.dtbo
Module.symvers
modules.order
# Editor compile database generated by build.sh (absolute device paths).
/drivers/dvs/build/
